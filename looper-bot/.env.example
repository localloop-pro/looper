OPENAI_API_KEY=your_openai_api_key_here
EXA_API_KEY=your_exa_api_key_here
# LocalLoop ecosystem (F4.1/F4.2) — defaults shown
LOOPER_API_BASE=http://localhost:8000
LOCALLOOP_MAP_URL=https://localloop.ai
# Read-only LocalLoop Bot Gateway (SPEC-055). Keep this token server-side in
# Electron main + the Worker only; use the same random secret (>=32 bytes).
LOCALLOOP_GATEWAY_URL=https://looper.localloop.ai
LOOPER_BOT_READ_TOKEN=

# Voice tuning (all optional — leave commented for the shipped defaults).
# OPENAI_REALTIME_MODEL=gpt-realtime-2
# LOOPER_VOICE=cedar                # try marin — OpenAI's other quality pick
# LOOPER_VAD_EAGERNESS=medium       # low | medium | high | auto (how fast Looper jumps in)
# LOOPER_VOICE_SPEED=1.0            # 0.25-1.5
# LOOPER_NOISE_REDUCTION=far_field  # far_field (laptop/room mic) | near_field (headset) | off
# LOOPER_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# LOOPER_TRANSCRIBE_LANGUAGE=en
