# looper — environment master table (PLACEHOLDERS ONLY — never commit real values)
# Real values live in: Coolify service secrets (production) + your password
# manager. See plans/IMPLEMENTATION_PLAN.md §7 for the full cross-system table.

# ── Looper backend ──────────────────────────────────────────────────────────
LOOPER_PORT=8000
# SQLite path is relative to the backend/ working dir (models.py binds at import)
LOOPER_DB_URL=sqlite:///data/looper.db

# ── HybridCard → Looper bridge (BRIDGE-CONTRACT-v1, FROZEN) ────────────────
# Generate the real secret ONCE with:  openssl rand -hex 32
# Same value must be set in the new-card service as HYBRIDCARD_INGEST_SECRET.
HYBRIDCARD_INGEST_SECRET=replace-with-openssl-rand-hex-32
# Comma-separated key ids accepted from X-HC-Key-Id (rotation seam)
HYBRIDCARD_KEY_IDS=hc-1

# ── TypeDB brain (Phase 2 — additive, off by default) ──────────────────────
# Local default: localhost:1729 (or :8000 if that is your local TypeDB port).
# Cloud main brain: AWS ap-southeast-2, TypeDB 3.12.1 Free (localloop).
# Real username/password live in .env.local + secrets/typedb-main-brain.env
TYPEDB_ENABLED=false
TYPEDB_ADDRESS=localhost:1729
TYPEDB_USERNAME=admin
TYPEDB_PASSWORD=replace-with-typedb-cloud-password
TYPEDB_VERSION=3.12.1
TYPEDB_CLOUD_PROVIDER=aws
TYPEDB_CLOUD_REGION=ap-southeast-2
TYPEDB_CLOUD_MACHINE=t4g.medium
TYPEDB_CLOUD_STORAGE_GB=10
TYPEDB_CLOUD_PLAN=free
TYPEDB_CLOUD_CREATED_BY=localloop
TYPEDB_CLOUD_LABEL=main-brain

# ── Widget / public URLs ────────────────────────────────────────────────────
# Prod: https://api.localloop.ai — the embeddable widget reads this
LOOPER_PUBLIC_API_BASE=http://localhost:8000

# ── News TTS (Phase 6 — F6.1 news audio worker) ────────────────────────────
NEWS_TTS_PROVIDER=
NEWS_TTS_API_KEY=

# ── LocalLoop pin bridge (sender / worker side — not read by looper-api) ───
LOCALLOOP_BRIDGE_URL=https://looper.localloop.ai/api/bridge

# Read-only KNS organization identity verification. Keep the official provider
# unless deliberately testing against an isolated mock. No wallet secrets are used.
KNS_API_BASE_URL=https://api.knsdomains.org/mainnet
KASPA_IDENTITY_TTL_SECONDS=3600
KASPA_IDENTITY_STALE_SECONDS=86400
# Seconds to serve the bounded stale/unavailable answer after a provider failure
# before retrying upstream (protects the API thread pool during outages).
KASPA_IDENTITY_FAILURE_BACKOFF_SECONDS=30
# Docker: keep this on the persistent volume (docker-compose.yml defaults to it).
KASPA_IDENTITY_CACHE_PATH=/app/data/kaspa_identity_cache.json
LOCALLOOP_BRIDGE_SECRET=replace-with-openssl-rand-hex-32

# ── Optional HybridCard-adjacent placeholders (not used by looper-api) ─────
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-local-jwt-secret
CORS_ORIGIN=http://localhost:3000
